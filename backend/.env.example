# Copy to .env (never commit it). Not needed in demo mode.

# Demo mode: fictional AWS account + scripted agents. No credentials needed.
# CLOUDSENTRY_DEMO=1

# Live mode
ANTHROPIC_API_KEY=
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1

# Optional
# CLOUDSENTRY_MODEL=claude-sonnet-5
# CLOUDSENTRY_POLL_INTERVAL=30     # seconds between AWS graph polls
# CLOUDSENTRY_AGENT_INTERVAL=60    # seconds between agent investigations
# CLOUDSENTRY_COST_TTL=3600        # seconds to cache Cost Explorer (it bills ~$0.01 per request)
# CLOUDSENTRY_ACTIONS_DB=cloudsentry_actions.db
# FRONTEND_ORIGIN=http://localhost:3000
